# Copy this file to .env and fill in the values. .env is git-ignored.
#
# Free Gemini API key for read-aloud: https://aistudio.google.com/apikey
# Create it in a NEW project without billing, so it stays on the free tier.
GEMINI_API_KEY=

# Free GIPHY key for the GIF picker: https://developers.giphy.com/dashboard
# (Create an App -> API -> copy the key). Tenor's API was discontinued.
GIPHY_API_KEY=
