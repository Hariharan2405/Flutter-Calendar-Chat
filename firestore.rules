rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App version metadata for in-app updates — readable by any signed-in
    // device; only writable from the Firebase console / admin (no client write).
    match /version_info/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Private data: notes and expenses per user.
    // Also allows access from a different device's anonymous UID after the user
    // logs back in with their profile — the profile doc stores 'currentAuthUid'
    // so the new device's UID is linked to the original profile UID.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/user_profiles/$(userId)).data.get('currentAuthUid', '') == request.auth.uid
      );
    }

    // Public user profiles (for chat discovery)
    match /user_profiles/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      // Owner can update anything; any auth user can update presence/device fields
      // (lastSeen for online status, fcmToken for notifications, currentAuthUid for cross-device login).
      // photoUrl is in that list because after a cross-device login the request's
      // auth UID is not the profile UID, and without it a user could not change
      // their own profile picture on that device at all.
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'currentAuthUid', 'lastSeen', 'photoUrl'])
      );

      // One document per signed-in device, holding that device's FCM token.
      // Writes are open to any authenticated user for the same reason the
      // parent document's presence fields are: after a cross-device login the
      // request's auth UID is not the profile UID. Reads are owner-only —
      // the Cloud Functions that fan out notifications use the Admin SDK and
      // bypass these rules entirely.
      match /devices/{deviceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null;
      }
    }

    // Camera share sessions — read/write by authenticated users.
    // IDs are unguessable UUIDs; target must explicitly accept before streaming starts.
    match /camera_shares/{shareId} {
      allow read, write: if request.auth != null;
    }

    // Voice & video calls — any authenticated user can read/write since call IDs
    // are unguessable UUIDs only shared via FCM to the target callee.
    match /calls/{callId} {
      allow read, write: if request.auth != null;
    }

    // Group chats — same relaxed auth pattern as personal chats.
    // Cross-device login means request.auth.uid ≠ the profile UID in participants,
    // so we gate on any authenticated user rather than participant membership.
    match /group_chats/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;

      match /messages/{messageId} {
        // Same relaxed auth pattern as the parent group_chats document.
        // The get()-based participant check was causing silent permission
        // failures on cross-device login (auth UID ≠ profile UID).
        allow read, write: if request.auth != null;
      }
    }

    // Statuses — visible to all authenticated users; only owner can delete.
    match /statuses/{statusId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // The only update the app performs is markViewed(), which writes
      // viewers.<uid>. Restricting non-owners to that key stops one user
      // rewriting another's caption, media URL or expiry — the owner branch is
      // kept so a future "edit my own status" path isn't blocked.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Chat rooms — participants can write; any auth user can read (admin view).
    // Update is relaxed to any auth user (like calls) because cross-device login
    // means request.auth.uid ≠ the profile UID stored in participants.
    match /chats/{chatId} {
      allow read: if request.auth != null;
      // Create is open to any auth user — chatId is derived from profile UIDs,
      // so only users who know those UIDs (via user_profiles read) can create chats.
      // Needed for cross-device login where auth UID ≠ profile UID in participants.
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
        request.auth.uid in resource.data.participants;

      // Messages: only participants (or cross-device users whose senderId is a
      // participant) can write. Cross-device login uses profile UID as senderId
      // while Firebase Auth UID is the device's anonymous UID.
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
